.vscode/*

/dist
**/dist/*

# Incremental build state. Machine-specific and rewritten on every build; the
# `tsconfig.lib.` one was already ignored but the plain one was not, so nine of
# them were tracked and churned on each commit.
*.tsbuildinfo

# Declarations emitted for the vite configs themselves. Generated, not source,
# and not shipped by any package's `files` — but they sat outside dist/, so the
# rules above never caught them and 14 were tracked across 7 libs.
vite.config.d.mts
vite.config.d.mts.map

/.idea

/.claude


.nx/cache
.nx/workspace-data
vite.config.*.timestamp*

# Expo
node_modules/
.expo/
.yarn/
dist/
npm-debug.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/
cache/
android/
ios/
# supabase CLI temp artifacts
apps/database/supabase/.temp/
# written by `db reset` against the local stack — per-machine, not shared state
apps/database/supabase/.branches/
# raw generations captured by the eval targets — a record of one run, not source
apps/api/eval-output/

# Generated image candidates. Curated by hand and committed in the CLIENT repo
# (they are bundled into the app binary), so the rolls themselves are scratch.
apps/database/operations/output/

# Env files. Derived by the `env-local` / `env-remote` targets, never authored.
#
# The glob matters as much as the bare name: `.env.production` holds the REMOTE
# service-role key, and a pattern of `.env` alone does not match it. Until this
# block existed the only thing keeping any of them out of a commit was a
# personal `~/.gitignore` — which is per-machine, so the protection did not
# exist for anyone else and would not have survived this repo being cloned.
.env
.env.*
!.env.example
