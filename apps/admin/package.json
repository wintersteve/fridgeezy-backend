{
    "name": "@fridgeezy/admin",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "nx": {
        "tags": [
            "scope:app"
        ],
        "targets": {
            "build": {
                "executor": "nx:run-commands",
                "cache": true,
                "inputs": [
                    "{projectRoot}/src/**/*",
                    "{projectRoot}/public/**/*",
                    "{projectRoot}/index.html",
                    "{projectRoot}/vite.config.mts",
                    {
                        "env": "VITE_SUPABASE_URL"
                    },
                    {
                        "env": "VITE_SUPABASE_ANON_KEY"
                    },
                    {
                        "env": "VITE_BACKEND_URL"
                    }
                ],
                "outputs": [
                    "{projectRoot}/dist"
                ],
                "options": {
                    "command": "npx vite build",
                    "cwd": "apps/admin"
                }
            },
            "serve": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "npx vite",
                    "cwd": "apps/admin"
                }
            }
        }
    },
    "dependencies": {
        "@fridgeezy/admin-contract": "0.0.1",
        "@mui/material": "^7.3.11",
        "@supabase/supabase-js": "2.90.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-router-dom": "^7.18.4"
    }
}
