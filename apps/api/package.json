{
    "name": "@fridgeezy/api",
    "version": "0.0.1",
    "private": true,
    "nx": {
        "tags": [
            "scope:app"
        ],
        "targets": {
            "build": {
                "executor": "@nx/esbuild:esbuild",
                "outputs": [
                    "{options.outputPath}"
                ],
                "defaultConfiguration": "production",
                "options": {
                    "platform": "node",
                    "outputPath": "apps/api/dist",
                    "format": [
                        "cjs"
                    ],
                    "bundle": false,
                    "main": "apps/api/src/main.ts",
                    "tsConfig": "apps/api/tsconfig.app.json",
                    "assets": [
                        "apps/api/src/assets"
                    ],
                    "esbuildOptions": {
                        "sourcemap": true,
                        "outExtension": {
                            ".js": ".js"
                        }
                    }
                },
                "configurations": {
                    "development": {},
                    "production": {
                        "esbuildOptions": {
                            "sourcemap": false,
                            "outExtension": {
                                ".js": ".js"
                            }
                        }
                    }
                }
            },
            "prune-lockfile": {
                "dependsOn": [
                    "build"
                ],
                "cache": true,
                "executor": "@nx/js:prune-lockfile",
                "outputs": [
                    "{workspaceRoot}/apps/api/dist/package.json",
                    "{workspaceRoot}/apps/api/dist/package-lock.json"
                ],
                "options": {
                    "buildTarget": "build"
                }
            },
            "copy-workspace-modules": {
                "dependsOn": [
                    "build"
                ],
                "cache": true,
                "outputs": [
                    "{workspaceRoot}/apps/api/dist/workspace_modules"
                ],
                "executor": "@nx/js:copy-workspace-modules",
                "options": {
                    "buildTarget": "build"
                }
            },
            "prune": {
                "dependsOn": [
                    "prune-lockfile",
                    "copy-workspace-modules"
                ],
                "executor": "nx:noop"
            },
            "serve": {
                "continuous": true,
                "executor": "@nx/js:node",
                "defaultConfiguration": "development",
                "dependsOn": [
                    "build"
                ],
                "options": {
                    "buildTarget": "@fridgeezy/api:build",
                    "runBuildTargetDependencies": false
                },
                "configurations": {
                    "development": {
                        "buildTarget": "@fridgeezy/api:build:development"
                    },
                    "production": {
                        "buildTarget": "@fridgeezy/api:build:production"
                    }
                }
            },
            "eval": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "npx jiti src/evals/dedup-authenticity.eval.ts",
                    "cwd": "apps/api"
                }
            },
            "calibrate": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "npx jiti src/evals/calibrate-thresholds.eval.ts",
                    "cwd": "apps/api"
                }
            },
            "calibrate-ingredients": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "npx jiti src/evals/calibrate-ingredients.eval.ts",
                    "cwd": "apps/api"
                }
            },
            "calibrate-authenticity": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "npx jiti src/evals/calibrate-authenticity.eval.ts",
                    "cwd": "apps/api"
                }
            },
            "eval-model-migration": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "npx jiti src/evals/model-migration/run.eval.ts",
                    "cwd": "apps/api",
                    "forwardAllArgs": true
                }
            },
            "check-streaming-conformance": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "npx jiti src/evals/model-migration/streaming-conformance.check.ts",
                    "cwd": "apps/api"
                }
            }
        }
    },
    "dependencies": {
        "@fridgeezy/domain": "0.0.1",
        "@fridgeezy/genai": "0.0.1",
        "@fridgeezy/llm": "0.0.1",
        "@fridgeezy/openai": "0.0.1",
        "@fridgeezy/schemas": "0.0.1",
        "@fridgeezy/streaming-server": "0.0.1",
        "@fridgeezy/supabase": "0.0.1",
        "@fridgeezy/toolkit": "0.0.1",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^5.2.1",
        "zod": "^4.2.1"
    },
    "devDependencies": {
        "@anthropic-ai/bedrock-sdk": "^0.32.0",
        "@aws-sdk/client-bedrock-runtime": "^3.1101.0",
        "@fridgeezy/bedrock": "0.0.1"
    }
}
