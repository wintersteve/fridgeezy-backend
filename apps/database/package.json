{
    "name": "@fridgeezy/database",
    "version": "0.0.1",
    "private": true,
    "nx": {
        "tags": [
            "scope:app"
        ],
        "targets": {
            "embed-ingredients": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "npx jiti operations/generate-embeddings.ts ingredients",
                    "cwd": "apps/database",
                    "forwardAllArgs": true
                }
            },
            "embed-categories": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "npx jiti operations/generate-embeddings.ts categories",
                    "cwd": "apps/database",
                    "forwardAllArgs": true
                }
            },
            "embed-units": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "npx jiti operations/generate-embeddings.ts units",
                    "cwd": "apps/database",
                    "forwardAllArgs": true
                }
            },
            "embed-tags": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "npx jiti operations/generate-embeddings.ts tags",
                    "cwd": "apps/database",
                    "forwardAllArgs": true
                }
            },
            "embed-suggestions": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "npx jiti operations/generate-embeddings.ts suggestions",
                    "cwd": "apps/database",
                    "forwardAllArgs": true
                }
            },
            "embed-recipes": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "npx jiti operations/generate-embeddings.ts recipes",
                    "cwd": "apps/database",
                    "forwardAllArgs": true
                }
            },
            "dedupe-ingredients": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "npx jiti operations/dedupe-ingredients.ts",
                    "cwd": "apps/database"
                }
            },
            "generate-ingredient-seed": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "npx jiti operations/generate-ingredient-seed.ts",
                    "cwd": "apps/database"
                }
            },
            "seed-ingredients": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "npx jiti operations/seed-ingredients.ts",
                    "cwd": "apps/database"
                }
            },
            "start": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "supabase start",
                    "cwd": "apps/database"
                }
            },
            "stop": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "supabase stop",
                    "cwd": "apps/database"
                }
            },
            "status": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "supabase status",
                    "cwd": "apps/database"
                }
            },
            "reset": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "supabase db reset",
                    "cwd": "apps/database"
                }
            },
            "up-remote": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "supabase migration up --linked",
                    "cwd": "apps/database"
                }
            },
            "reset-remote": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "supabase db reset --linked",
                    "cwd": "apps/database"
                }
            },
            "env-local": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "npx jiti codegen/generate-env.ts",
                    "cwd": "apps/database",
                    "forwardAllArgs": true
                }
            },
            "env-remote": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "npx jiti codegen/generate-env.ts --remote",
                    "cwd": "apps/database",
                    "forwardAllArgs": true
                }
            },
            "types": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "npx jiti codegen/generate-types.ts --local && npx jiti codegen/generate-entity-types.ts",
                    "cwd": "apps/database"
                }
            },
            "types-remote": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "npx jiti codegen/generate-types.ts && npx jiti codegen/generate-entity-types.ts",
                    "cwd": "apps/database"
                }
            },
            "generate-cuisine-banners": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "npx jiti operations/generate-cuisine-banners.ts",
                    "cwd": "apps/database",
                    "forwardAllArgs": true
                }
            },
            "generate-cuisine-cards": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "npx jiti operations/generate-cuisine-cards.ts",
                    "cwd": "apps/database",
                    "forwardAllArgs": true
                }
            },
            "generate-dish-tiles": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "npx jiti operations/generate-dish-tiles.ts",
                    "cwd": "apps/database",
                    "forwardAllArgs": true
                }
            },
            "generate-app-icon": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "npx jiti operations/generate-app-icon.ts",
                    "cwd": "apps/database",
                    "forwardAllArgs": true
                }
            },
            "generate-splash": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "npx jiti operations/generate-splash.ts",
                    "cwd": "apps/database",
                    "forwardAllArgs": true
                }
            },
            "backfill-course-tags": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "npx jiti operations/backfill-course-tags.ts",
                    "cwd": "apps/database"
                }
            },
            "backfill-dish-form-tags": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "npx jiti operations/backfill-dish-form-tags.ts",
                    "cwd": "apps/database"
                }
            },
            "strip-cuisine-from-names": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "npx jiti operations/strip-cuisine-from-names.ts",
                    "cwd": "apps/database"
                }
            },
            "check-recipe-visibility": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "npx jiti operations/check-recipe-visibility.ts",
                    "cwd": "apps/database"
                }
            },
            "check-menu-visibility": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "npx jiti operations/check-menu-visibility.ts",
                    "cwd": "apps/database"
                }
            },
            "classify-ingredient-diet": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "npx jiti operations/classify-ingredient-diet.ts",
                    "cwd": "apps/database"
                }
            }
        }
    },
    "dependencies": {
        "@fridgeezy/dietary": "0.0.1",
        "@fridgeezy/genai": "0.0.1",
        "@fridgeezy/llm": "0.0.1",
        "@fridgeezy/openai": "0.0.1",
        "@fridgeezy/supabase": "0.0.1",
        "@fridgeezy/toolkit": "0.0.1",
        "@fridgeezy/types": "0.0.1",
        "ts-case-convert": "^2.1.0"
    }
}
