{
  "expo": {
    "name": "Fridgeezy",
    "slug": "fridgeezy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/core/assets/images/icon.png",
    "scheme": "fridgeezy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "usesAppleSignIn": true,
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSCameraUsageDescription": "This app needs camera access",
        "NSMicrophoneUsageDescription": "This app needs microphone access"
      },
      "bundleIdentifier": "com.anonymous.fridgeezy"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/core/assets/images/adaptive-icon.png",
        "backgroundColor": "#1E1E1E"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.fridgeezy",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/core/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/core/assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1E1E1E"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera"
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-apple-authentication",
      "expo-quick-actions"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f1b4e907-564f-4a50-8a63-ee7af8e570e0"
      }
    }
  }
}
