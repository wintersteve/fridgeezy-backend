{
    "name": "@fridgeezy/site",
    "version": "0.0.1",
    "private": true,
    "nx": {
        "tags": [
            "scope:app"
        ],
        "targets": {
            "build": {
                "executor": "nx:run-commands",
                "cache": true,
                "inputs": [
                    "{projectRoot}/src/**/*",
                    {
                        "env": "SITE_ORIGIN"
                    }
                ],
                "outputs": [
                    "{projectRoot}/dist"
                ],
                "options": {
                    "command": "npx jiti src/build.ts",
                    "cwd": "apps/site"
                }
            }
        }
    }
}
