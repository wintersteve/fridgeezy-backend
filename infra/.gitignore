.terraform/
.terraform-artifacts/

# .terraform.lock.hcl is intentionally NOT ignored — it pins provider versions
# and must be committed.

# State lives in S3 (versions.tf). These patterns stay: `init -migrate-state`
# leaves the pre-migration state behind as a local file, and a stray
# `-backend=false` or a failed init can recreate one at any time.
*.tfstate
*.tfstate.*
crash.log

# Never commit real values; environments/*.tfvars hold non-secret config only.
*.auto.tfvars
secrets.tfvars
