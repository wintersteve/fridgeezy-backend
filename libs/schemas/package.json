{
    "name": "@fridgeezy/schemas",
    "version": "0.0.1",
    "description": "Shared Zod schemas for Fridgeezy applications",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "@fridgeezy/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "keywords": [
        "fridgeezy",
        "schemas",
        "zod",
        "validation"
    ],
    "license": "MIT",
    "dependencies": {
        "zod": "^4.0.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "nx": {
        "tags": [
            "scope:shared"
        ]
    }
}
