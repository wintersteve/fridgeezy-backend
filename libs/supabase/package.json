{
    "name": "@fridgeezy/supabase",
    "version": "0.0.1",
    "description": "Supabase client utilities and helpers for Fridgeezy applications",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "@fridgeezy/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "keywords": [
        "fridgeezy",
        "supabase",
        "database",
        "client"
    ],
    "license": "MIT",
    "scripts": {
        "generate:types": "node ../../tools/scripts/generate-entity-types.mjs"
    },
    "dependencies": {
        "@fridgeezy/domain": "*",
        "@fridgeezy/types": "*",
        "@supabase/supabase-js": "^2.89.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "nx": {
        "tags": [
            "scope:shared"
        ]
    }
}
